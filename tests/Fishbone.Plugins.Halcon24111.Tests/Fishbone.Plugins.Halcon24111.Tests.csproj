<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- tests that need HALCON itself use [HalconFact] and skip where it isn't installed, like CI -->
  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Fishbone\Fishbone.csproj" />
    <ProjectReference Include="..\..\src\Fishbone.Debugging\Fishbone.Debugging.csproj" />
    <ProjectReference Include="..\..\src\Fishbone.Interpreter\Fishbone.Interpreter.csproj" />
    <ProjectReference Include="..\..\plugins\Fishbone.Plugins.Halcon24111\Fishbone.Plugins.Halcon24111.csproj" />
  </ItemGroup>

  <!-- the same threshold procedure saved plain and password-protected (password "miguel") in HDevelop -->
  <ItemGroup>
    <None Include="Procedures\**\*.hdvp" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\samples\halcon_images.fb" Link="halcon_images.fb" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
