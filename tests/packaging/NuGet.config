<?xml version="1.0" encoding="utf-8"?>
<!-- the consumer takes Fishbone packages only from the local pack, never from nuget.org -->
<configuration>
  <packageSources>
    <clear />
    <add key="local" value="../../artifacts" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="local">
      <package pattern="Fishbone" />
      <package pattern="Fishbone.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
