<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- it isn't packaged, so it's built for both, like the libraries it runs on -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>spine</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Fishbone\Fishbone.csproj" />
    <ProjectReference Include="..\..\src\Fishbone.Core\Fishbone.Core.csproj" />
    <ProjectReference Include="..\..\src\Fishbone.Parser\Fishbone.Parser.csproj" />
    <ProjectReference Include="..\..\src\Fishbone.Debugging\Fishbone.Debugging.csproj" />
  </ItemGroup>

</Project>
