<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>spineide</AssemblyName>
    <!-- the project moved to Fishbone.SpineIDE but the source namespaces did not,
         so pin this rather than let it follow the new project name -->
    <RootNamespace>SpineIDE</RootNamespace>
    <ApplicationIcon>Assets\fishbone.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\fishbone.tmLanguage.json" />
    <EmbeddedResource Include="Assets\Themes\dark_plus.json" />
    <EmbeddedResource Include="Assets\Themes\onedark-color-theme.json" />
    <EmbeddedResource Include="Assets\Themes\onelight-color-theme.json" />
    <EmbeddedResource Include="..\..\samples\*.fb">
      <LogicalName>SpineIDE.Samples.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\Fonts\*" />
  </ItemGroup>


  <ItemGroup>
    <Folder Include="Models/Layout/" />
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.4" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.0.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.4" />
	<PackageReference Include="Avalonia.Themes.Simple" Version="12.0.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.4" />
    <!--Condition below is needed to remove Avalonia.Diagnostics package from build output in Release configuration.-->
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.17">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="AvaloniaEdit.TextMate" Version="12.0.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Dock.Avalonia" Version="12.0.0.2" />
    <PackageReference Include="Dock.Avalonia.Themes.Fluent" Version="12.0.0.2" />
	<PackageReference Include="Dock.Avalonia.Themes.Simple" Version="12.0.0.2" />
    <PackageReference Include="Dock.Model.Mvvm" Version="12.0.0.2" />
    <PackageReference Include="MessageBox.Avalonia" Version="12.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.8" />
    <PackageReference Include="System.CommandLine" Version="2.0.9" />
    <PackageReference Include="TextMateSharp.Grammars" Version="2.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Fishbone.DebugClient\Fishbone.DebugClient.csproj" />
    <ProjectReference Include="..\..\src\Fishbone\Fishbone.csproj" />
    <!-- Fishbone marks its sibling projects PrivateAssets=all so they pack as one
         package, which means they no longer transitive. reference what we use -->
    <ProjectReference Include="..\..\src\Fishbone.Core\Fishbone.Core.csproj" />
    <ProjectReference Include="..\..\src\Fishbone.Parser\Fishbone.Parser.csproj" />
    <ProjectReference Include="..\..\src\Fishbone.Interpreter\Fishbone.Interpreter.csproj" />
    <ProjectReference Include="..\Fishbone.Dap\Fishbone.Dap.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="CopyFishboneDapHost" AfterTargets="Build">
    <ItemGroup>
      <FishboneDapHostFiles Include="$(MSBuildProjectDirectory)\..\Fishbone.Dap\bin\$(Configuration)\$(TargetFramework)\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(FishboneDapHostFiles)"
          DestinationFiles="@(FishboneDapHostFiles->'$(OutDir)daphost\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>