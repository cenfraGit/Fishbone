<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <!-- one build for every runtime: .NET 8 when it is there, otherwise the newest installed -->
    <RollForward>Major</RollForward>
    <AssemblyName>spineide</AssemblyName>
    <RootNamespace>SpineIDE.Win32</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>fishbone.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- only the native editor dll is used, not the winforms wrapper around it -->
    <PackageReference Include="Scintilla5.NET" Version="7.0.0" ExcludeAssets="all" GeneratePathProperty="true" />
    <None Include="$(PkgScintilla5_NET)\runtimes\win-x64\native\Scintilla.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fishbone.SpineIDE.Shared\Fishbone.SpineIDE.Shared.csproj" />
    <ProjectReference Include="..\..\src\Fishbone\Fishbone.csproj" />
    <ProjectReference Include="..\..\src\Fishbone.Core\Fishbone.Core.csproj" />
    <ProjectReference Include="..\..\src\Fishbone.Parser\Fishbone.Parser.csproj" />
    <ProjectReference Include="..\..\src\Fishbone.Interpreter\Fishbone.Interpreter.csproj" />
    <ProjectReference Include="..\..\src\Fishbone.DebugClient\Fishbone.DebugClient.csproj" />
    <ProjectReference Include="..\Fishbone.Dap\Fishbone.Dap.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- the debug client launches fishbone-dap from a daphost folder next to the exe, in a
       build and in a publish. the files are gathered inside targets because on a clean
       checkout the dap output does not exist yet when the project is evaluated. the dap
       project is asked for its own output folder, since a runtime adds a subfolder to it -->
  <Target Name="FindFishboneDapHost">
    <MSBuild Projects="..\Fishbone.Dap\Fishbone.Dap.csproj" Targets="GetTargetPath">
      <Output TaskParameter="TargetOutputs" PropertyName="FishboneDapTargetPath" />
    </MSBuild>
    <PropertyGroup>
      <FishboneDapDir>$([System.IO.Path]::GetDirectoryName('$(FishboneDapTargetPath)'))\</FishboneDapDir>
    </PropertyGroup>
    <ItemGroup>
      <FishboneDapHostFiles Include="$(FishboneDapDir)**\*" />
    </ItemGroup>
  </Target>

  <Target Name="CopyFishboneDapHost" AfterTargets="Build" DependsOnTargets="FindFishboneDapHost">
    <Copy SourceFiles="@(FishboneDapHostFiles)"
          DestinationFiles="@(FishboneDapHostFiles->'$(OutDir)daphost\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="PublishFishboneDapHost" AfterTargets="ComputeResolvedFilesToPublishList" DependsOnTargets="FindFishboneDapHost">
    <ItemGroup>
      <ResolvedFileToPublish Include="@(FishboneDapHostFiles)"
                             RelativePath="daphost\%(RecursiveDir)%(Filename)%(Extension)"
                             CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>
