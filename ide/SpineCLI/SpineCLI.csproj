<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>spine</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Fishbone.Engine\Fishbone.Engine.csproj" />
    <ProjectReference Include="..\..\src\Fishbone.Hosting\Fishbone.Hosting.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- referenced directly because the Fishbone package packs these assemblies
         rather than depending on them, so they no longer flow through
         Fishbone.Engine to whatever references it -->
    <ProjectReference Include="..\..\src\Fishbone.Core\Fishbone.Core.csproj" />
    <ProjectReference Include="..\..\src\Fishbone.Debugging\Fishbone.Debugging.csproj" />
  </ItemGroup>

</Project>
