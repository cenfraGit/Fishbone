<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Fishbone.g4" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Antlr4.Runtime.Standard" Version="4.13.1" />
    <PackageReference Include="Antlr4BuildTasks" Version="12.14.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="**/*.g4" />
    <Antlr4 Include="**/*.g4">
      <Generator>Visitor</Generator>
    </Antlr4>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Fishbone" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fishbone.Core\Fishbone.Core.csproj" />
  </ItemGroup>

</Project>
