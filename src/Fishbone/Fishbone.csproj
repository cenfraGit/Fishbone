<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>true</IsPackable>
    <PackageId>Fishbone</PackageId>
    <Description>A small, debuggable scripting language designed for .NET interop.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);BundleSiblings</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\misc\fb_icon.png" Pack="true" PackagePath="\" />
    <None Include="..\..\docs\*.md" Pack="true" PackagePath="docs\" />
    <None Include="..\..\samples\*.fb" Pack="true" PackagePath="samples\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fishbone.Debugging\Fishbone.Debugging.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Fishbone.Core\Fishbone.Core.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Fishbone.Interpreter\Fishbone.Interpreter.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\Fishbone.Parser\Fishbone.Parser.csproj" PrivateAssets="all" />
    <!-- redeclared, Parser's PrivateAssets hides this -->
    <PackageReference Include="Antlr4.Runtime.Standard" Version="4.13.1" />
  </ItemGroup>

  <Target Name="BundleSiblings" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <BuildOutputInPackage Include="@(ReferenceCopyLocalPaths->WithMetadataValue('ReferenceSourceTarget','ProjectReference'))" />
    </ItemGroup>
  </Target>

</Project>