// title: Bubble Sort

println("Bubble Sort\n");

func bubble_sort(arr)
{
    let i = 0;
    let size = arr.Count;
    while (i < size)
    {
        let j = 0;
        while (j < (size - i - 1))
        {
            let left = arr[j];
            let right = arr[j + 1];

            // if left greater, swap
            if (left > right)
            {
                arr[j] = right;
                arr[j + 1] = left;
            }
            j = j + 1;
        }
        i = i + 1;
    }
}

func print_list(list)
{
    let concatString = "";
    let first = true;
    foreach (item in list)
    {
        if (not first)
            concatString += ", ";

        concatString += item.ToString();
        first = false;
    }
    
    println(concatString);
}

let numbers = [54, 12, 89, 3, 21];

print("Before sorting: ");
print_list(numbers);

bubble_sort(numbers);

print("\nAfter sorting:");
print_list(numbers);