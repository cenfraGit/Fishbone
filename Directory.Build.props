<Project>

  <!-- ================================================================================
       language settings every project shares.

       TargetFramework is deliberately absent: the libraries target net8.0 so the widest
       set of hosts can consume them, and the applications target net10.0 because an app
       is free to be newer than the libraries it uses. plugins follow the libraries, not
       the applications, or a net8.0 host cannot load them.
       ================================================================================ -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- ================================================================================
       the one place a release number is set.

       clear VersionSuffix to cut the real 1.0.0. note the guard in FishbonePluginLoader
       compares the engine's major version, so bumping the major here is what makes an
       older plugin refuse to load.
       ================================================================================ -->
  <PropertyGroup>
    <VersionPrefix>1.0.0</VersionPrefix>
    <VersionSuffix>preview.1</VersionSuffix>
  </PropertyGroup>

  <!-- ================================================================================
       package identity, shared by everything that ships
       ================================================================================ -->
  <PropertyGroup>
    <Authors>cenfraGit</Authors>
    <Company>cenfraGit</Company>
    <Copyright>Copyright (c) 2026 cenfraGit</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/cenfraGit/Fishbone</PackageProjectUrl>
    <RepositoryUrl>https://github.com/cenfraGit/Fishbone</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>fishbone;scripting;scripting-language;dotnet-interop;embedded;antlr</PackageTags>
    <Description>Fishbone is a small scripting language for native .NET interop, designed to be embedded in a host application.</Description>
  </PropertyGroup>

  <!-- the antlr runtime is used by Fishbone.Parser and restated as a dependency by the
       Fishbone package, since Parser's project reference is private there. one version in
       one place so those two cannot drift -->
  <PropertyGroup>
    <AntlrRuntimeVersion>4.13.1</AntlrRuntimeVersion>
  </PropertyGroup>

  <!-- nothing ships unless it asks to. a project that should be published sets
       IsPackable to true in its own file, so adding a project never accidentally
       adds a package -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- ================================================================================
       reproducible builds and debuggable packages.

       SourceLink for github ships inside the sdk from .net 8 onward, so there is no
       PackageReference to add here. ContinuousIntegrationBuild normalizes paths, which
       is only correct on a build machine, so it stays off locally.
       ================================================================================ -->
  <PropertyGroup>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!-- the xml summaries in this repo are worth shipping, so a consumer sees them in intellisense.
       this cannot be conditioned on IsPackable in Directory.Build.targets: that file is imported
       after the sdk targets have already derived DocumentationFile from it, so the setting arrives
       too late and no xml is produced. confirmed by packing and finding lib/ without it. the cost
       of setting it repo-wide is an unused xml file beside each test assembly.

       CS1591 is "missing xml comment on a public member". the generated antlr parser
       alone publishes 142 public types and would raise thousands, so the warning is off
       and documentation coverage is a review question rather than a build error -->
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

</Project>
