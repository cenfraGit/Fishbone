<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- build as a self-contained, loadable plugin: copies OpenCvSharp (managed + native) -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <!-- Fishbone.Engine pulls Core/Interpreter/Debugging/Parser in behind it, and marking the
         direct reference non-copying does not stop those landing in the output. A plugin shipping
         its own Fishbone.Core risks the loader binding to it instead of the host's, which would
         make IFishbonePlugin a different type than the one the host checks against. -->
    <DisableTransitiveProjectReferences>true</DisableTransitiveProjectReferences>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Description>OpenCV for Fishbone. Registers Cv2 as "cv" and Mat as a constructible type, so a script can call cv.CvtColor, cv.GaussianBlur, cv.Canny and the rest with lists standing in for Size, Point and Scalar.</Description>
    <PackageTags>$(PackageTags);fishbone-plugin;opencv;computer-vision</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <!-- the host already has Fishbone.Engine loaded; reference it for the IFishbonePlugin
         contract but do NOT ship a second copy -->
    <ProjectReference Include="..\..\src\Fishbone.Engine\Fishbone.Engine.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OpenCvSharp4" Version="4.10.0.20241108" />
    <!-- native runtimes: NuGet places each under runtimes/{rid}/native, and a RID-specific
         publish (-r win-x64 / -r linux-x64) flattens the right one next to the plugin dll -->
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.10.0.20241108" />
    <PackageReference Include="OpenCvSharp4.official.runtime.linux-x64" Version="4.10.0.20241108" />
  </ItemGroup>

</Project>
